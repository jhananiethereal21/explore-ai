# EXPLORE AI - Environment Variables Template
# Copy this file to .env.local for local testing with the Gemini API.
# Note: EXPLORE AI functions out-of-the-box with a high quality built-in demo engine
# even if no GEMINI_API_KEY is provided!

# Server-side Gemini API Key (never prefix with VITE_ to keep it private)
GEMINI_API_KEY=your_gemini_api_key_here
